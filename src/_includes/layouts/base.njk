<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title and page.url != '/' %}{{ title }} | {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or 'The Asheville Board Game Club meets weekly to play board games. Everyone is welcome.' }}" />
    <link rel="icon" href="/img/favicon.png" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/img/logo-128.webp" alt="" width="64" height="64" />
        <span>{{ site.name }}</span>
      </a>
      <nav aria-label="Main">
        <ul class="tabs">
          {%- for item in site.nav %}
          {#- News posts live under /news/, so the News tab stays highlighted while reading one. #}
          {%- set isCurrent = (item.url == '/' and page.url == '/') or (item.url != '/' and page.url.startsWith(item.url)) %}
          <li><a href="{{ item.url }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>{{ site.name }}</p>
    </footer>
  </body>
</html>
